    "configuracion": {
        "modo_robot": 15,
        "motor_type": 0,
        "servo_4m": 0,
        "servo_2m": 1,
        "pixel_led": 1,
        "ultrasonido": 1,
        "color": 1,
        "perfil": "completo"
    },
    "programa": {
        "txt": "colorant = 7\n\ncolor = 7\nrojo = 0\nverde = 1\nazul = 2\nnaranja = 5\n\nloop{\n    repetir 5{\n        color = leerColor \n    }\n\n    si color != colorant {\n        imprimir color \n        finLinea \n\n        colorant = color \n        si color == verde{\n            pixel 0 100 0\n            adelante 100 0.5\n            adelante 100\n            pixel 0 100 0 \n        }\n\n        si color == rojo{\n            pixel 100 0 0    \n            izquierda 100 0.55\n            pausa 100\n            adelante 100\n            pixel 0 100 0  \n        }\n\n        si color == azul {\n            pixel 0 0 100\n            derecha 100 0.55\n            pausa 100\n            adelante 100\n            pixel 0 100 0 \n        }\n\n        si color == naranja {\n            pixel 100 50 0\n            parar\n            pausa 1000  \n        }\n    }\n    \n\n}",
        "blockly_xml": null
    },
    "fuente_principal": "txt"
}